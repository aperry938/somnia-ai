# Somnia.ai Environment Configuration
# Copy this file to .env.local and fill in your values

# Gemini API Key - With proxy enabled, this is only needed for local dev without Supabase
# In production, the key is stored as a Supabase Edge Function secret (GEMINI_API_KEY)
# Get your key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_api_key_here

# ======================
# SUPABASE CONFIGURATION
# ======================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ======================
# REVENUECAT CONFIGURATION
# ======================
# Get these from https://app.revenuecat.com → Project Settings → API Keys
# iOS key: Select your iOS app, copy the Public API Key
VITE_REVENUECAT_IOS_KEY=appl_...

# Android key: Select your Android app, copy the Public API Key
VITE_REVENUECAT_ANDROID_KEY=goog_...

# ======================
# SUPERUSER ACCESS
# ======================
# Superuser emails (comma-separated) - get premium access for testing
VITE_SUPERUSER_EMAILS=your-email@example.com
