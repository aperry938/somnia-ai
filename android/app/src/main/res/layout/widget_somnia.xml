<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:id="@+id/widget_container">

    <!-- Header with app name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Somnia" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Somnia"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Next Alarm Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Alarm"
            android:textColor="#B8B8FF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No alarm set"
            android:textColor="#B8B8FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Sleep Stats Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- Average Sleep -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg Sleep"
                android:textColor="#B8B8FF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_avg_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--h --m"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sleep Score -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score"
                android:textColor="#B8B8FF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_sleep_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Streak -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streak"
                android:textColor="#B8B8FF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- days"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/widget_btn_alarm"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_background"
            android:src="@android:drawable/ic_lock_idle_alarm"
            android:contentDescription="Set Alarm"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/widget_btn_sleep"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_background"
            android:src="@android:drawable/ic_menu_recent_history"
            android:contentDescription="Sleep Now"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/widget_btn_stats"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_background"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="View Stats"
            android:padding="12dp" />
    </LinearLayout>

</LinearLayout>
