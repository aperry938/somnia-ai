<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Somnia</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Background Modes - Required for alarm to play when app is backgrounded -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- Microphone and Speech Recognition -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Somnia uses the microphone to capture your dreams via voice memo, making it faster to record dreams when you wake up.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Somnia uses speech recognition to transcribe your voice memos into text for your dream journal.</string>

	<!-- HealthKit - For sleep tracking integration -->
	<key>NSHealthShareUsageDescription</key>
	<string>Somnia reads your sleep data from Apple Health to provide personalized sleep insights and track your sleep patterns automatically.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Somnia can save your sleep data to Apple Health to keep all your health information in one place.</string>

	<!-- Notifications - Critical for alarms -->
	<key>NSUserNotificationUsageDescription</key>
	<string>Somnia sends notifications for your alarms and sleep reminders.</string>

	<!-- Motion - For sleep detection -->
	<key>NSMotionUsageDescription</key>
	<string>Somnia uses motion data to detect when you fall asleep and improve smart alarm timing.</string>

	<!-- Quick Actions (3D Touch / Long Press on app icon) -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>ai.somnia.app.set_alarm</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Set Alarm</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Set a wake-up alarm</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAlarm</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>route</key>
				<string>/alarm</string>
			</dict>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>ai.somnia.app.start_sleep</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Sleep Now</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Start tracking your sleep</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeTime</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>route</key>
				<string>/sleep</string>
			</dict>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>ai.somnia.app.view_stats</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Sleep Stats</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>View your sleep statistics</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeSearch</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>route</key>
				<string>/stats</string>
			</dict>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>ai.somnia.app.record_dream</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Record Dream</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Record a dream in your journal</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCompose</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>route</key>
				<string>/journal/new</string>
			</dict>
		</dict>
	</array>

	<!-- Deep Links URL Scheme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>somnia</string>
			</array>
			<key>CFBundleURLName</key>
			<string>ai.somnia.app</string>
		</dict>
	</array>
</dict>
</plist>
